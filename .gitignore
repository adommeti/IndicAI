.env
.env.stack
.venv
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
# Golden audio is synthetic and hash-pinned by audio_manifest.jsonl, so it is
# committed: cloud sessions clone the repo and cannot regenerate it for free.
!platform/eval/golden/**/audio/*.wav
*.egg-info/
/build/
dist/
docs/eval/
.DS_Store

# Per-session agent state (logs, gate cache, prompt marker) — never committed.
.claude/run/
.claude/settings.local.json
CLAUDE.local.md

# Other tools' local harness config
.codex/
.codex-runs/
.agents/
AGENTS.md

# Local backups of harness files
*.bak

# UI packages: source is tracked, build output and browser caches are not.
apps/*/ui/node_modules/
apps/*/ui/dist/
apps/*/ui/test-results/
apps/*/ui/playwright-report/
apps/*/ui/.env.e2e
