# Vendor credentials go in .env; make bootstrap creates private local .env.stack.
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
LIVE_API_TESTS=0
ADAPTER_RPM=1000
# Generated by bootstrap; example URL shapes only. .env.stack takes precedence.
STACK_PASSWORD=
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3002
LANGFUSE_TRACING_ENABLED=true
DATABASE_URL=postgresql+psycopg://platform@localhost:15433/platform
REDIS_URL=redis://localhost:6380/0
QDRANT_URL=http://localhost:6333
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=
# Transport for MinIO. Defaults to TRUE when unset, and `false` is REFUSED unless ENV is
# one of dev/local/test/ci (apps/comms_surveillance/storage.py). The presigned URL uc3's
# reviewer API hands a browser for call audio is a bearer token for a recording and lives
# for 180 seconds; minted over http anyone on the path can replay it. The local Docker
# stack is plaintext, so local development sets this explicitly next to ENV=dev.
MINIO_SECURE=false
# uc1 voice channel (uc1/P5). LiveKit runs locally from docker-compose
# (livekit/livekit-server:v1.9.0, config infra/livekit.yaml) and starts with
# `make stack-voice`; every port is bound to 127.0.0.1. LIVEKIT_URL is the
# WebSocket signalling URL the agent and the browser both connect to.
# LIVEKIT_API_KEY/LIVEKIT_API_SECRET are the pair that signs participant join
# tokens; the server trusts them because docker-compose passes the same pair in
# as LIVEKIT_KEYS. The secret is generated per checkout by `make bootstrap` into
# the private .env.stack (LIVEKIT_API_SECRET=STACK_PASSWORD) and is empty here
# on purpose -- do not set a value in this file, and do not hand-edit one half
# of the pair. A join token is a credential to hear the call: mint it with a
# short TTL (apps/helpdesk_agent/voice_demo.md, step 2).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=
TEI_URL=http://localhost:8080
SPARSE_URL=http://localhost:8081
RETRIEVAL__PARALLEL_TRANSLATE=false
RETRIEVAL__TRANSLATE_DEADLINE_S=0.250
GRAFANA_URL=http://localhost:3001
PROMETHEUS_URL=http://localhost:9090
# uc3 comms_surveillance ingestion
UC3_BUCKET=comms-surveillance
UC3_PREFIX=recordings/
# true routes transliteration through Sarvam (costs money, phonological, needed
# for Tamil); unset uses the offline indic-transliteration backend.
SARVAM_TRANSLITERATE=false
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# Shared auth switches (uc3/P6, and uc1/P6 which reuses the same names).
# Deployment environment. Anything that is not one of dev/local/test/ci refuses
# AUTH__DEV_BYPASS outright -- including an UNSET or misspelt value, so the
# failure mode of a typo is a locked door. Checked at startup and again per
# request, in both apps: apps/comms_surveillance/auth.py and
# apps/helpdesk_agent/roles.py.
ENV=dev
# Mints a fixed test identity instead of requiring a verified SSO subject.
# Local only; the API refuses to start with this set when ENV=prod.
AUTH__DEV_BYPASS=false
# Which roles that fixed identity carries: compliance_reviewer, compliance_lead,
# governance (comma separated). Defaults to reviewer+lead. `governance` is
# subtractive (ADR 0013), so a bypass granting all three would deny the local UI
# the transcripts it exists to render -- set it alone to see the governance view.
AUTH__DEV_BYPASS_ROLES=
# Browser half of the same switch, read by both apps' UIs. It grants nothing on
# its own: without the server-side AUTH__DEV_BYPASS above, every API route still
# answers 401 and the UI renders its unauthenticated state. Defined once, here --
# the uc1 UI block further down deliberately does not repeat it, because a second
# definition would silently win and nobody would know which one they had edited.
VITE_AUTH_DEV_BYPASS=true
#
# CAREFUL, cross-app: AUTH__DEV_BYPASS_ROLES above is ONE name read by BOTH apps,
# and `governance` means opposite things in them (ADR 0015). Setting
# AUTH__DEV_BYPASS_ROLES=governance to reach uc3's governance view simultaneously
# gives uc1's bypass identity full session replay. That is the conflation the ADR
# forbids, re-created in the one place this repo controls -- so set it per shell
# for the app you are actually running, not once in a shared file.
#
# uc1's bypass shares the two AUTH__DEV_BYPASS* names but NOT their vocabulary:
# uc1 knows only `governance`, and uc1's `governance` GRANTS session replay while
# uc3's DENIES transcripts (ADR 0015). A uc3 role name set here yields no roles in
# uc1 rather than silently crossing over. uc1 defaults the bypass identity to
# `governance` so the local replay view renders.
#
# Langfuse project id, needed to turn a turn's trace_id into a clickable link in
# the replay payload. Without it the API returns langfuse_url: null and a reviewer
# pastes the trace id in by hand -- a host-only URL would render and then 404,
# which reads as a lost trace rather than an unconfigured deployment.
# docker-compose sets LANGFUSE_INIT_PROJECT_ID: indic-platform, so that is the
# right local value.
LANGFUSE_PROJECT_ID=indic-platform

# uc1 helpdesk ticketing (Zammad, compose profile `ticketing`: make stack-ticketing).
# Both empty here and in a fresh checkout; ticket filing stays off until they are set.
# ZAMMAD_URL is the base URL of the Zammad instance, no /api/v1 suffix: the local
# compose profile publishes it on http://localhost:8082.
# ZAMMAD_TOKEN is a personal access token, not a password. Mint one in Zammad:
# finish the first-run web wizard as an admin, then avatar menu > Profile >
# Token Access > Create, granting admin.group and admin.object (for
# `python -m helpdesk_agent.zammad_seed`) plus ticket.agent (to file tickets).
# Keep the value in .env, never in this file.
ZAMMAD_URL=
ZAMMAD_TOKEN=

# --- uc1/P7 security and retention -------------------------------------------
# Spend caps (PRD threat T9, denial of wallet). Amounts are INR, the one currency
# both vendor legs share (`platform/config/pricing.yaml` prices Sarvam natively in
# INR and converts the Anthropic leg). SESSION and DAY are the caps that REFUSE a
# call before the vendor is reached; MONTHLY is not a refusal — it is the
# denominator for the 50/80/100% alerts. Set a cap to 0 to stop tracking that
# scope. UNKNOWN_RESERVE is the headroom a call of unknowable cost must find free
# before it is admitted: a streaming STT bills on audio duration nobody knows up
# front, so it reserves this much and is reconciled to the real cost afterwards.
# The ledger is shared through REDIS_URL above when set, and per-process otherwise.
BUDGET__ENABLED=true
BUDGET__MONTHLY_INR=50000
BUDGET__SESSION_INR=250
BUDGET__DAY_INR=5000
BUDGET__UNKNOWN_RESERVE_INR=5
# Retention (PRD C8, threat T5 over-retention). Days, counted from a row's
# created_at; a zero or negative window is refused rather than coerced, because a
# typo that made the cutoff `now` would delete everything. BATCH_SIZE is rows per
# transaction. DRY_RUN deploys the beat in rehearsal mode: it reports and logs what
# it would delete and deletes nothing, which is how you want to run it the first
# time against real data.
UC1_AUDIO_RETENTION_DAYS=30
UC1_TRANSCRIPT_RETENTION_DAYS=90
UC1_RETENTION_BATCH_SIZE=500
UC1_RETENTION_DRY_RUN=false

# --- uc3 retention (uc3/P7) ---------------------------------------------------
# Unset on purpose, and both of them. uc3's window is "per Compliance's recordkeeping
# rule" (PRD T5), which is docs/adr/0004 -- deliberately unwritten, because it needs a
# written answer from Compliance, Legal and HR that cannot be derived from this repo.
#
# UC3_CALL_RETENTION_DAYS unset means no window, which means keep everything: the sweep
# still runs nightly and still writes its audit rows, reporting that it had no rule to
# apply. UC3_RETENTION_ENABLED is the second gate and defaults to false, so even a
# configured window only rehearses until somebody who has read ADR 0004 turns it on.
# Deletion needs BOTH. Setting a number here without that conversation turns an open
# legal question into a deletion policy.
#
# What the sweep can delete: transcript_segments and the source recordings. NOT the
# chained tables, and not `calls` -- once a call is analysed its row is pinned by a
# foreign key from analysis_runs/flags, which the app role cannot delete. See ADR 0016.
UC3_CALL_RETENTION_DAYS=
UC3_RETENTION_ENABLED=false
UC3_RETENTION_BATCH_SIZE=500

# --- uc1 helpdesk web widget (uc1/P6) ----------------------------------------
# Every VITE_* value is baked into the bundle at BUILD time, not read at runtime:
# rebuild after changing one. None of them is a secret -- a client id and a tenant
# are public, and nothing here mints a token.
VITE_API_BASE=
# Browser half of the dev bypass. Honoured only when it is exactly "true" AND the
# page is on a loopback origin; off-loopback a bypass build falls back to real
# MSAL sign-in and says so, rather than silently admitting a test identity. It
# grants nothing server-side -- pair it with AUTH__DEV_BYPASS near the top of this
# file, which is where VITE_AUTH_DEV_BYPASS itself is defined (once).
# Entra ID application (client) id and tenant for MSAL. VITE_MSAL_AUTHORITY
# overrides the authority if your tenant needs a non-default one.
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT=
VITE_MSAL_AUTHORITY=
# The API scope the widget requests a token for (api://<client-id>/<scope>).
VITE_API_SCOPE=
# Where the widget asks for a LiveKit join token. Same-origin paths only; a
# cross-origin value is refused, because a join token is a credential to hear the
# call. NO SUCH ENDPOINT EXISTS YET (docs/build/BLOCKERS.md) -- leave it unset and
# the widget says voice is unavailable instead of showing a dead mic.
VITE_LIVEKIT_TOKEN_PATH=
# The room's WebSocket URL, when a deployment serves one directly.
VITE_LIVEKIT_URL=ws://localhost:7880
